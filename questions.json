          "options": [
            { "id": "A", "text": "NT$1,000 以下（入門款）", "setFlag": "lightweight" },
            { "id": "B", "text": "NT$1,000–3,000（中階款）" },
            { "id": "C", "text": "NT$3,000–8,000（進階款）" },
            { "id": "D", "text": "NT$8,000 以上（旗艦款）" },
            { "id": "E", "text": "尚未購買，但有研究過磨豆機市場" }
          ]
        },
        {
          "id": "Q3B",
          "type": "single",
          "text": "您是否曾經根據不同咖啡豆的產區或處理法調整研磨刻度？",
          "showIf": "Q3.includes('A')",
          "options": [
            { "id": "A", "text": "是，經常這樣做，並記錄不同豆款對應的刻度設定" },
            { "id": "B", "text": "偶爾會調整，但不會特別記錄" },
            { "id": "C", "text": "很少調整，通常固定一個刻度" },
            { "id": "D", "text": "不清楚研磨刻度對風味的影響" }
          ]
        }
      ]
