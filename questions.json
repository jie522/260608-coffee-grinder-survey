{
  "title": "手搖磨豆機市場調查問卷",
  "subtitle": "Manual Coffee Grinder Consumer Research Survey",
  "version": "v4",
  "description": "目標族群：進階咖啡玩家（手搖磨豆機進階使用者）",
  "sections": [
    {
      "id": "S1",
      "title": "第一部分：篩選題",
      "questions": [
        {
          "id": "Q1",
          "type": "single",
          "text": "您是否有飲用咖啡的習慣？",
          "options": [
            { "id": "A", "text": "是，每天都喝" },
            { "id": "B", "text": "是，偶爾喝（每週1–3次）" },
            { "id": "C", "text": "很少喝（每月數次）", "skipTo": "END" },
            { "id": "D", "text": "幾乎不喝", "skipTo": "END" }
          ]
        },
        {
          "id": "Q2",
          "type": "single",
          "text": "您是否會自行在家沖煮咖啡？",
          "options": [
            { "id": "A", "text": "是，主要自己沖煮" },
            { "id": "B", "text": "偶爾自己沖，也會外購" },
            { "id": "C", "text": "幾乎都外購，不自己沖", "skipTo": "END" }
          ]
        },
        {
          "id": "Q3",
          "type": "multiple",
          "text": "您目前使用過哪種類型的磨豆機？（可複選）",
          "note": "此題決定後續分流",
          "options": [
            { "id": "A", "text": "手搖磨豆機（手動）" },
            { "id": "B", "text": "電動磨豆機（家用）" },
            { "id": "C", "text": "電動磨豆機（商用等級）" },
            { "id": "D", "text": "從未使用過磨豆機，使用預磨粉" },
            { "id": "E", "text": "其他：", "hasInput": true }
          ],
          "skipLogic": [
            {
              "condition": "notSelected:A",
              "skipQuestions": ["Q3A", "Q3B", "Q12", "Q13", "Q14", "Q15"]
            },
            {
              "condition": "onlySelected:D",
              "skipQuestions": ["Q3A", "Q3B", "Q12", "Q13", "Q14", "Q15", "Q17", "Q19", "Q25"]
            }
          ]
        },
        {
          "id": "Q3A",
          "type": "single",
          "text": "您目前使用或最近一台手搖磨豆機的購入價格約為？",
